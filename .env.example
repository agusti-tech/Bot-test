# Database
DATABASE_URL="postgresql://restaurant_app:change_me@localhost:5432/restaurant_db"
POSTGRES_USER=restaurant_app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=restaurant_db

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET=change_me_to_a_random_secret
# Do NOT set AUTH_URL — trustHost: true in auth.ts detects the host automatically.
# Setting AUTH_URL to localhost causes redirect loops when behind a proxy (e.g. Cloudflare).

# API Key for n8n integration (generate with: openssl rand -base64 32)
API_KEY=change_me_to_a_random_api_key

# AI Reservation Assistant (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Seed scripts (never commit real passwords; rotate if they were ever in git)
# SEED_ADMIN_PASSWORD=             # Min 8 chars, for prisma/seed.ts super admin
# SEED_OWNER_PASSWORD=             # Min 8 chars, for prisma/seed.ts restaurant owner
# SEED_HAUS_MUELLER_EMAIL=owner@haus-mueller.de
# SEED_HAUS_MUELLER_PASSWORD=      # Min 8 chars, for npm run seed:haus-mueller

# Optional AI config
# MAX_CONCURRENT_RESERVATIONS=10   # Max reservations per time slot before reporting full
# CHAT_RATE_LIMIT_RPM=20           # Max chat messages per minute per IP
# AI_SESSION_TTL_MINUTES=30        # Conversation memory duration
