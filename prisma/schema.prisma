generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String      @id @default(cuid())
  email          String      @unique
  hashedPassword String
  name           String
  role           Role        @default(OWNER)
  restaurantId   String?
  restaurant     Restaurant? @relation(fields: [restaurantId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

enum Role {
  SUPER_ADMIN
  OWNER
}

model Restaurant {
  id              String            @id @default(cuid())
  slug            String            @unique
  name            Json              // { "en": "...", "de": "..." }
  description     Json              // { "en": "...", "de": "..." }
  address         String
  phone           String?
  email           String?
  openingHours    Json              // { "monday": { "open": "09:00", "close": "22:00" }, ... }
  logoUrl         String?
  imageUrl        String?
  isActive        Boolean           @default(true)
  settings        Json?             // { defaultDiningDuration: 90, bufferMinutes: 15, maxWaitlistSize: 20 }
  users           User[]
  categories      MenuCategory[]
  reservations    Reservation[]
  tables          RestaurantTable[]
  guests          Guest[]
  waitlistEntries WaitlistEntry[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model MenuCategory {
  id           String     @id @default(cuid())
  name         Json       // { "en": "...", "de": "..." }
  sortOrder    Int        @default(0)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        MenuItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId])
}

model MenuItem {
  id          String       @id @default(cuid())
  name        Json         // { "en": "...", "de": "..." }
  description Json?        // { "en": "...", "de": "..." }
  price       Decimal      @db.Decimal(8, 2)
  imageUrl    String?
  dietaryTags String[]     // ["vegetarian", "vegan", "gluten-free", ...]
  isAvailable Boolean      @default(true)
  sortOrder   Int          @default(0)
  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([categoryId])
}

// --- Table Management ---

model RestaurantTable {
  id              String          @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  label           String          // "T1", "Bar 3", "Patio 2"
  minCapacity     Int             @default(1)
  maxCapacity     Int             // e.g. 4
  shape           TableShape      @default(RECTANGLE)
  zone            String?         // "Main Dining", "Patio", "Bar", "Private Room"
  posX            Float           @default(0)
  posY            Float           @default(0)
  width           Float           @default(80)
  height          Float           @default(80)
  rotation        Float           @default(0)
  isActive        Boolean         @default(true)
  isCombinable    Boolean         @default(false)
  sortOrder       Int             @default(0)
  reservations           Reservation[] @relation("PrimaryTable")
  reservationsAsCombined Reservation[] @relation("CombinedTable")
  waitlistEntries WaitlistEntry[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([restaurantId])
}

enum TableShape {
  ROUND
  SQUARE
  RECTANGLE
  BOOTH
}

// --- Guest CRM ---

model Guest {
  id                  String          @id @default(cuid())
  restaurantId        String
  restaurant          Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name                String
  phone               String?
  email               String?
  notes               String?
  dietaryRestrictions String[]
  tags                String[]        // ["VIP", "regular", "wine-lover"]
  seatingPreference   String?         // "window", "booth", "patio"
  totalVisits         Int             @default(0)
  noShowCount         Int             @default(0)
  lastVisitAt         DateTime?
  reservations        Reservation[]
  waitlistEntries     WaitlistEntry[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([restaurantId, phone])
  @@index([restaurantId])
}

// --- Waitlist ---

model WaitlistEntry {
  id               String           @id @default(cuid())
  restaurantId     String
  restaurant       Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  guestId          String?
  guest            Guest?           @relation(fields: [guestId], references: [id])
  guestName        String
  guestPhone       String?
  partySize        Int
  seatingPref      String?
  notes            String?
  estimatedWaitMin Int?
  status           WaitlistStatus   @default(WAITING)
  tableId          String?
  table            RestaurantTable? @relation(fields: [tableId], references: [id])
  notifiedAt       DateTime?
  seatedAt         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([restaurantId, status])
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  SEATED
  LEFT
  CANCELLED
}

// --- Reservations (enhanced) ---

model Reservation {
  id                String            @id @default(cuid())
  restaurantId      String
  restaurant        Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  date              DateTime          @db.Date
  time              String            // "19:00"
  partySize         Int
  guestName         String
  guestEmail        String?
  guestPhone        String
  notes             String?
  status            ReservationStatus @default(PENDING)
  source            String            @default("web") // "web", "phone", "ai_assistant", "walk_in"
  tableId              String?
  table                RestaurantTable?  @relation("PrimaryTable", fields: [tableId], references: [id])
  combinedWithTableId  String?
  combinedWithTable    RestaurantTable?  @relation("CombinedTable", fields: [combinedWithTableId], references: [id])
  guestId           String?
  guest             Guest?            @relation(fields: [guestId], references: [id])
  estimatedDuration Int               @default(90) // minutes
  seatingPreference String?
  seatedAt          DateTime?
  completedAt       DateTime?
  cleaningClearedAt DateTime?          // when host marks "cleaning done" / table free
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([restaurantId, date])
  @@index([tableId, date])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}
